// Prisma schema for users, albums, photos, EXIF metadata, and tags

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  albums   Album[]
  photos   Photo[]   @relation("UserPhotos")
}

model Album {
  id          String   @id @default(cuid())
  title       String
  description String?
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner  User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  photos Photo[]

  @@index([ownerId])
}

model Photo {
  id          String   @id @default(cuid())
  albumId     String
  uploaderId  String
  url         String
  thumbnailUrl String?
  title       String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  album    Album @relation(fields: [albumId], references: [id], onDelete: Cascade)
  uploader User  @relation("UserPhotos", fields: [uploaderId], references: [id], onDelete: Cascade)
  meta     PhotoMeta?
  tags     PhotoTag[]

  @@index([albumId])
  @@index([uploaderId])
}

model PhotoMeta {
  photoId              String   @id
  takenAt              DateTime?
  cameraMake           String?
  cameraModel          String?
  lensModel            String?
  focalLength          Float?
  aperture             Float?
  shutterSpeed         String?
  iso                  Int?
  latitude             Float?
  longitude            Float?
  altitude             Float?
  width                Int?
  height               Int?
  orientation          Int?
  flash                Boolean?
  whiteBalance         String?
  exposureCompensation Float?

  photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)
}

model Tag {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  photos PhotoTag[]
}

model PhotoTag {
  photoId   String
  tagId     String
  assignedAt DateTime @default(now())

  photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([photoId, tagId])
  @@index([tagId])
  @@index([photoId])
}

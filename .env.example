# Public settings
NEXT_PUBLIC_APP_NAME=aibase

# Node environment is typically set by your package manager or hosting platform
# NODE_ENV=development

# Database
# Postgres connection string used by Prisma and the app
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aibase?schema=public
# Optional: used by Prisma Migrate in development
# SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aibase_shadow?schema=public

# Queue / Redis
REDIS_URL=redis://localhost:6379
QUEUE_NAME=jobs
JOB_CONCURRENCY=5
QUEUE_METRICS_PORT=9464

# Sentry (optional)
# Obtain DSN from Sentry project settings
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2

# Demo job simulator (for local testing)
ENABLE_JOB_SIMULATOR=false
JOB_SIMULATOR_RATE_PER_MINUTE=30

# Alerting (Prometheus Alertmanager)
# Configure receivers in config/alertmanager/alertmanager.yml using these envs
PAGERDUTY_ROUTING_KEY=
ALERT_EMAIL_TO=

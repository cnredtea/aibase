# Public settings
NEXT_PUBLIC_APP_NAME=aibase

# Node environment is typically set by your package manager or hosting platform
# NODE_ENV=development

# Database
# Postgres connection string used by Prisma and the app
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aibase?schema=public
# Optional: used by Prisma Migrate in development
# SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aibase_shadow?schema=public

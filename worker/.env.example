# Image worker environment variables

# HTTP
PORT=8080
HEALTHCHECK_PATH=/healthz

# Queue provider: 'redis' or 'sqs'
QUEUE_PROVIDER=redis
WORKER_CONCURRENCY=5

# Redis (used when QUEUE_PROVIDER=redis)
REDIS_URL=redis://localhost:6379/0
QUEUE_NAME=image-jobs

# AWS SQS (used when QUEUE_PROVIDER=sqs)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SQS_QUEUE_URL=

# S3/R2 object storage
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_SOURCE=uploads
S3_BUCKET_DEST=processed
S3_FORCE_PATH_STYLE=true

# Optional database URL for health check (e.g. PostgreSQL)
DATABASE_URL=
